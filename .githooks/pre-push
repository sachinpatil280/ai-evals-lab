#!/bin/sh
. "$(git rev-parse --show-toplevel)/.githooks/identity.sh"
remote_url="$2"

[ "$remote_url" = "$REQUIRED_REMOTE" ] || die "push target is '$remote_url', expected '$REQUIRED_REMOTE'"

# The SSH key behind the remote's host alias must authenticate as the personal account.
greeting=$(ssh -T -o BatchMode=yes -o ConnectTimeout=10 "${REQUIRED_REMOTE%%:*}" 2>&1)
case "$greeting" in
  "Hi $REQUIRED_NAME!"*) ;;
  *) die "SSH key authenticates as: '$greeting'" ;;
esac

zero=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then range="$local_sha"; else range="$remote_sha..$local_sha"; fi
  bad=$(git log --format='%h %ae %ce' "$range" | awk -v e="$REQUIRED_EMAIL" '$2 != e || $3 != e')
  [ -z "$bad" ] || die "commits with wrong author/committer email:
$bad"
done
